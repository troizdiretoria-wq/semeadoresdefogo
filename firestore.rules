rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'arthursantosprojetos@gmail.com' ||
        (hasUserDoc() && getUserData().role == 'admin_global' && getUserData().status == 'active')
      );
    }

    function isActiveMinister() {
      return isSignedIn() && (
        request.auth.token.email == 'arthursantosprojetos@gmail.com' ||
        (hasUserDoc() && getUserData().status == 'active')
      );
    }

    function isConsolidationWorker() {
      return isAdmin() || (
        hasUserDoc() &&
        getUserData().status == 'active' && (
          getUserData().role == 'equipe_consolidacao' ||
          getUserData().role == 'coordenador_regional'
        )
      );
    }

    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Health ping test document
    match /test/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users Collection (Strict Protection against Privilege Escalation)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'regionId', 'authUid', 'id'])
      );
    }

    // Regions Collection
    match /regions/{regionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Members (Semeadores)
    match /members/{memberId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (
        isActiveMinister() &&
        (getUserData().role == 'coordenador_regional' || getUserData().role == 'lider_evangelismo') &&
        (getUserData().regionId == null || getUserData().regionId == request.resource.data.regionId)
      );
      allow update: if isAdmin() || (
        isActiveMinister() &&
        (getUserData().regionId == null || getUserData().regionId == resource.data.regionId)
      );
      allow delete: if isAdmin();
    }

    // Evangelism Events
    match /evangelismEvents/{eventId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (
        isActiveMinister() &&
        (getUserData().regionId == null || getUserData().regionId == request.resource.data.regionId)
      );
      allow update: if isAdmin() || (
        isActiveMinister() &&
        (getUserData().regionId == null || getUserData().regionId == resource.data.regionId)
      );
      allow delete: if isAdmin();
    }

    // Bimonthly Reports
    match /bimonthlyReports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (
        isActiveMinister() &&
        (getUserData().regionId == null || getUserData().regionId == request.resource.data.regionId)
      );
      allow update: if isAdmin() || (
        isActiveMinister() &&
        (getUserData().regionId == null || getUserData().regionId == resource.data.regionId) &&
        resource.data.status != 'Aprovado'
      );
      allow delete: if isAdmin();
    }

    // Consolidation Contacts (Strict LGPD Protection)
    match /consolidationContacts/{contactId} {
      allow read, write: if isConsolidationWorker();
    }

    // Course Modules & Classes
    match /courseModules/{moduleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /courseClasses/{classId} {
      allow read: if isSignedIn();
      allow write: if isActiveMinister();
    }

    match /enrollments/{enrollmentId} {
      allow read, write: if isActiveMinister();
    }

    match /certificates/{certificateId} {
      allow read, write: if isActiveMinister();
    }

    // Departments & Tasks
    match /departments/{departmentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read, write: if isActiveMinister();
    }

    // Meetings
    match /meetings/{meetingId} {
      allow read, write: if isActiveMinister();
    }

    // Crusades
    match /crusades/{crusadeId} {
      allow read, write: if isActiveMinister();
    }

    // Media & Official Assets
    match /mediaAssets/{assetId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Audit Logs (Immutable, append-only)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Financial Records
    match /financialRecords/{recordId} {
      allow read, write: if isAdmin();
    }
  }
}
