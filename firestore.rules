rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'arthursantosprojetos@gmail.com' ||
        (hasUserDoc() && getUserData().role == 'admin_global')
      );
    }

    function isConsolidationWorker() {
      return isAdmin() || (
        hasUserDoc() && (
          getUserData().role == 'equipe_consolidacao' ||
          getUserData().role == 'coordenador_regional'
        )
      );
    }

    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection Health Verification Document
    match /test/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users Collection (Strict RBAC - Prevents Privilege Escalation)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'id'])
      );
    }

    // Regions Collection (Global Administration)
    match /regions/{regionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Members (Semeadores)
    match /members/{memberId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Evangelism Events
    match /evangelismEvents/{eventId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Bimonthly Reports
    match /bimonthlyReports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && resource.data.status != 'Aprovado');
      allow delete: if isAdmin();
    }

    // Consolidation Contacts (Strict LGPD PII Protection)
    match /consolidationContacts/{contactId} {
      allow read, write: if isConsolidationWorker();
    }

    // School of Ministry (Course Modules & Classes)
    match /courseModules/{moduleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /courseClasses/{classId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /enrollments/{enrollmentId} {
      allow read, write: if isSignedIn();
    }

    match /certificates/{certificateId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Departments & Tasks
    match /departments/{departmentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read, write: if isSignedIn();
    }

    // Meetings
    match /meetings/{meetingId} {
      allow read, write: if isSignedIn();
    }

    // Media & Official Assets
    match /mediaAssets/{assetId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Audit Logs (Immutable, Append-Only)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Financial Records (Restricted to Global Admin)
    match /financialRecords/{recordId} {
      allow read, write: if isAdmin();
    }
  }
}
