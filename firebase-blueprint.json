  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles and permissions"
    },
    "/regions/{regionId}": {
      "schema": { "$ref": "#/entities/Region" },
      "description": "Regional ministerial units"
    },
    "/members/{memberId}": {
      "schema": { "$ref": "#/entities/Member" },
      "description": "Registered Semeadores"
    },
    "/evangelismEvents/{eventId}": {
      "schema": { "$ref": "#/entities/EvangelismEvent" },
      "description": "Evangelism actions and field results"
    },
    "/bimonthlyReports/{reportId}": {
      "schema": { "$ref": "#/entities/BimonthlyReport" },
      "description": "Bimonthly accountability reports"
    },
    "/consolidationContacts/{contactId}": {
      "schema": { "$ref": "#/entities/ConsolidationContact" },
      "description": "Evangelized contacts with LGPD consent"
    },
    "/courseModules/{moduleId}": {
      "schema": { "$ref": "#/entities/CourseModule" },
      "description": "The 4 study modules"
    },
    "/courseClasses/{classId}": {
      "schema": { "$ref": "#/entities/CourseClass" },
      "description": "Training classes and Zoom links"
    },
    "/enrollments/{enrollmentId}": {
      "schema": { "$ref": "#/entities/Enrollment" },
      "description": "Student enrollments"
    },
    "/certificates/{certificateId}": {
      "schema": { "$ref": "#/entities/Certificate" },
      "description": "Official completion certificates"
    },
    "/crusades/{crusadeId}": {
      "schema": { "$ref": "#/entities/Crusade" },
      "description": "Crusade plans and operational checklists"
    },
    "/departments/{departmentId}": {
      "schema": { "$ref": "#/entities/Department" },
      "description": "10 strategic ministerial departments"
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Department tasks and activities"
    },
    "/meetings/{meetingId}": {
      "schema": { "$ref": "#/entities/Meeting" },
      "description": "Leadership alignment meetings"
    },
    "/mediaAssets/{assetId}": {
      "schema": { "$ref": "#/entities/MediaAsset" },
      "description": "Brand assets and media catalog"
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Administrative audit trail"
    },
    "/financialRecords/{recordId}": {
      "schema": { "$ref": "#/entities/FinancialRecord" },
      "description": "Budget and travel cost estimates"
    }
  }
}
